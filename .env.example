# REST: axios baseURL → https://host/api/...
VITE_API_URL=https://your-backend.onrender.com/api
# Socket.IO HTTP origin only (no /path). Preferred explicit name:
VITE_SOCKET_URL=https://your-backend.onrender.com
# Legacy alias for socket origin (optional if VITE_SOCKET_URL set):
# VITE_BACKEND_URL=https://your-backend.onrender.com
# Optional: cap reconnect attempts (default 25)
# VITE_SOCKET_MAX_RECONNECT_ATTEMPTS=25
VITE_GOOGLE_CLIENT_ID=your-google-client-id
