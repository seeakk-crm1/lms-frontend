{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/((?!assets/|.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|svg|ico|webp|avif|woff|woff2|ttf|eot|wasm)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:route(login|forgot-password|reset-password|invite|activate-account|workspace|dashboard|admin|unlock-staff|salary|settings|leads|calendar|reports|attendance|location-tracker|lob-analysis|sheets|master|privacy-policy|terms|data-deletion)",
      "destination": "/index.html"
    },
    {
      "source": "/:route(login|forgot-password|reset-password|invite|activate-account|workspace|dashboard|admin|unlock-staff|salary|settings|leads|calendar|reports|attendance|location-tracker|lob-analysis|sheets|master|privacy-policy|terms|data-deletion)/:path*",
      "destination": "/index.html"
    }
  ]
}
